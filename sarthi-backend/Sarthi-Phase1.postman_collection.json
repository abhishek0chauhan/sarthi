    {
      "name": "Destination Finder",
      "item": [
        {
          "name": "Beach Vacation \u2014 fit young woman",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const res = pm.response.json();",
                  "pm.test('Has mode field', () => pm.expect(res).to.have.property('mode'));",
                  "pm.test('Has results array', () => pm.expect(res.results).to.be.an('array'));",
                  "pm.test('Results not empty', () => pm.expect(res.results.length).to.be.greaterThan(0));",
                  "pm.test('Each result has healthAdvisory', () => res.results.forEach(r => pm.expect(r).to.have.property('healthAdvisory')));",
                  "pm.test('Each result has costBreakdown', () => res.results.forEach(r => pm.expect(r).to.have.property('costBreakdown')));",
                  "pm.test('costBreakdown has total', () => res.results.forEach(r => pm.expect(r.costBreakdown).to.have.property('total')));",
                  "pm.test('Each result has permits', () => res.results.forEach(r => pm.expect(r).to.have.property('permits')));",
                  "pm.test('permits has required field', () => res.results.forEach(r => pm.expect(r.permits).to.have.property('required')));",
                  "pm.test('Each result has tripReadiness', () => res.results.forEach(r => pm.expect(r).to.have.property('tripReadiness')));",
                  "pm.test('tripReadiness has score 0-100', () => res.results.forEach(r => { pm.expect(r.tripReadiness.score).to.be.a('number'); pm.expect(r.tripReadiness.score).to.be.at.least(0); pm.expect(r.tripReadiness.score).to.be.at.most(100); }));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{idToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/destination-finder/search",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "destination-finder",
                "search"
              ]
            },
