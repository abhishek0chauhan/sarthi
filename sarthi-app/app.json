{
  "expo": {
    "name": "SarthiGo",
    "slug": "sarthi",
    "scheme": "sarthi",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "ios": { "supportsTablet": false, "icon": "./assets/icon.png" },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E8601C"
      },
      "package": "com.sarthi.app",
      "googleServicesFile": "./google-services.json"
    },
    "web": { "bundler": "metro" },
    "plugins": [
      "expo-router",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Sarthi to track your location during your trip for nearby suggestions."
        }
      ]
    ]
  }
}
